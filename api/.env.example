# Copy to api/.env for local development (`cp api/.env.example api/.env`). Never commit api/.env.
# These are names and IDs, not secrets. Get the Cognito values from: cd infra && pulumi stack output

# DynamoDB Local from docker-compose (create tables + seed with: pnpm db:local)
DYNAMODB_ENDPOINT=http://localhost:8000

# Cognito (needed for the auth routes; public routes work without them)
USER_POOL_ID=
USER_POOL_CLIENT_ID=
COGNITO_DOMAIN_URL=
